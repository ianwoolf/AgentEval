FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3 \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/control/package.json apps/control/package.json
COPY apps/example-mcp-server/package.json apps/example-mcp-server/package.json
COPY apps/runner/package.json apps/runner/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --include=optional

FROM dependencies AS build
COPY tsconfig.base.json ./
COPY apps/control ./apps/control
COPY packages ./packages
RUN npm run build:evaluation --workspace @tasklattice/control

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY deploy/nginx/evaluation.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/control/dist-evaluation /usr/share/nginx/html
EXPOSE 8080
